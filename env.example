# Gemini API 設定 (優先使用)
GEMINI_API_KEY=your_gemini_api_key
# 可用 GEMINI_MODELS 設定多個模型，會由左到右依序嘗試；舊的 GEMINI_MODEL 仍可使用。
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI 或相容的第 3 方 API 設定
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_URL=https://yourai.com/v1
# 可用 OPENAI_MODELS 設定多個模型，#1 失敗會自動改用 #2；舊的 OPENAI_MODEL 仍可使用。
OPENAI_MODELS=gpt-4o,gpt-4o-mini
# OPENAI_MODEL=gpt-4o

# 額外的 OpenAI 相容 Proxy (可依序新增 PROXY_1, PROXY_2, PROXY_3...)
# 當前面的 API 或模型失敗時，會自動依序嘗試下一個模型 / Proxy
# PROXY_1_API_KEY=your_proxy1_api_key
# PROXY_1_API_URL=https://proxy1.example.com/v1
# PROXY_1_MODELS=model-name-1,model-name-2
# PROXY_1_MODEL=model-name

# PROXY_2_API_KEY=your_proxy2_api_key
# PROXY_2_API_URL=https://proxy2.example.com/v1
# PROXY_2_MODELS=model-name-1,model-name-2
# PROXY_2_MODEL=model-name
