# Gemini API 設定 (優先使用)
GEMINI_API_KEY=your_gemini_api_key
# 可用 GEMINI_MODELS 設定多個模型，會由左到右依序嘗試；舊的 GEMINI_MODEL 仍可使用。
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI 相容 Provider 設定（建議新格式）
# Provider #1 為主；當 Provider #1 的所有模型都失敗後，才會改用 Provider #2。
OPENAI_1_API_KEY=your_provider1_api_key
OPENAI_1_API_URL=https://provider1.example.com/v1
OPENAI_1_MODELS=model-1,model-2

# OPENAI_2_API_KEY=your_provider2_api_key
# OPENAI_2_API_URL=https://provider2.example.com/v1
# OPENAI_2_MODELS=model-1,model-2

# 舊格式仍相容：OPENAI_* 視為主 provider，PROXY_1_* 起視為備用 provider。
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_API_URL=https://yourai.com/v1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini
# PROXY_1_API_KEY=your_proxy1_api_key
# PROXY_1_API_URL=https://proxy1.example.com/v1
# PROXY_1_MODELS=model-name-1,model-name-2
